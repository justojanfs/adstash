{
  "manifest_version": 3,
  "name": "AdStash — Ad Library Pribadi",
  "short_name": "AdStash",
  "version": "1.3.1",
  "description": "Simpan iklan dari Facebook, Instagram, dan TikTok ke ad library pribadimu: media, caption, pengiklan, kategori, dan catatan.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AdStash",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.tiktok.com/*",
    "https://ads.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*",
    "https://*.ibyteimg.com/*",
    "https://*.byteoversea.com/*",
    "https://*.muscdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://ads.tiktok.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-hovered": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Simpan postingan yang sedang ditunjuk kursor"
    }
  }
}
